# Copy to .env.local for local development (never commit .env.local)

# --- Database (pick one) ---

# Local Docker Postgres (see docker-compose if used):
# DATABASE_URL="postgresql://lkstudio:lkstudio@localhost:5432/lkstudio?schema=public"

# Supabase â€” direct connection (good for local `prisma db push`, migrations, long-lived dev server):
# Password: Supabase Dashboard â†’ Project Settings â†’ Database â†’ Database password
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.stbyjzngeegpycuxiubo.supabase.co:5432/postgres"

# Supabase â€” pooler (use on Render / serverless; Prisma needs transaction mode + pgbouncer flag):
# Dashboard â†’ Connect â†’ Connection string â†’ Transaction pooler (port 6543), then append:
#   ?pgbouncer=true&connection_limit=1
# Example shape (replace region/host from your dashboard):
# DATABASE_URL="postgresql://postgres.stbyjzngeegpycuxiubo:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

JWT_SECRET="change-me-to-a-long-random-string-in-production"

# Supabase client (SSR / browser â€” Project Settings â†’ API; set real values in .env.local only)
# Publishable key is safe in the browser; never put service_role in NEXT_PUBLIC_* vars.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: skip demo seed on production deploy
# SKIP_DEMO_SEED=true

# File uploads â€” leave empty for local disk (public/uploads). Set for Play Store / Vercel:
# S3_BUCKET=your-bucket
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://your-bucket.s3.ap-south-1.amazonaws.com
# S3_ENDPOINT=  # Cloudflare R2: https://<account>.r2.cloudflarestorage.com

# Razorpay (subscriptions / autopay)
# Server: Key ID + Key Secret from Razorpay Dashboard -> Account & Settings -> API Keys (Test mode for dev).
# Webhook: Dashboard -> Webhooks -> secret for POST /api/subscription/webhook
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Optional: pre-created plan IDs; if empty, the app creates plans via API on first checkout
# RAZORPAY_PLAN_ID_SHOP=
# RAZORPAY_PLAN_ID_CUSTOMER=
# Client checkout (same Key ID as RAZORPAY_KEY_ID; never put Key Secret in NEXT_PUBLIC_*)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx

# WhatsApp OTP (Meta Cloud API)
# WHATSAPP_CLOUD_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TEMPLATE_NAME=lk_studio_login

# Public site URL (privacy policy links, metadata)
# NEXT_PUBLIC_SITE_URL=https://lk-studio-1.onrender.com

# Demo UI â€” hidden in production unless explicitly enabled:
# NEXT_PUBLIC_SHOW_DEMO_LOGIN=false
# NEXT_PUBLIC_SHOW_DEMO_OTP=false

# Never enable on production Play Store build:
# LOGIN_OTP_DEMO=false
# ALLOW_DEMO_FEATURES=false
