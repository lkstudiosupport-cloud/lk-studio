# Production — use PostgreSQL for 100+ concurrent users (SQLite locks with heavy load).
# Example: Neon, Supabase, Railway, or your own Postgres server.
#
# DATABASE_URL="postgresql://user:password@host:5432/lkstudio?schema=public&connection_limit=20&pool_timeout=20"
#
# Then set prisma/schema.prisma provider to "postgresql" and run: npx prisma db push
#
# Run multiple Next.js instances behind nginx — each handles hundreds of users.
# NODE_ENV=production
# JWT_SECRET=change-to-long-random-string

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/lkstudio?schema=public&connection_limit=20"

# Subscription UPI — shown in Profile payment guide (PhonePe / GPay)
# LKSTUDIO_UPI_ID=yourname@ybl
# LKSTUDIO_PAYEE_NAME=LK Studio
#
# Subscription autopay (Razorpay — UPI mandate, card, wallet)
# RAZORPAY_KEY_ID=rzp_test_xxxx
# RAZORPAY_KEY_SECRET=xxxx
# RAZORPAY_WEBHOOK_SECRET=whsec_xxxx
# Optional pre-created plan IDs from Razorpay Dashboard:
# RAZORPAY_PLAN_ID_SHOP=plan_xxxx
# RAZORPAY_PLAN_ID_CUSTOMER=plan_xxxx
#
# WhatsApp login OTP (Meta WhatsApp Business Cloud API)
# Create an authentication template in Meta Business Manager (body = {{1}} for code).
# WHATSAPP_CLOUD_TOKEN=your_permanent_access_token
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_OTP_TEMPLATE_NAME=lk_studio_login
# WHATSAPP_OTP_TEMPLATE_LANG=en
#
# Or POST OTP to your own service (n8n, Cloud Function, etc.):
# WHATSAPP_OTP_WEBHOOK=https://your-server.com/send-whatsapp-otp
#
# Dev: show OTP on screen when WhatsApp is not connected
# LOGIN_OTP_DEMO=true
