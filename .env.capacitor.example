# Copy to .env.capacitor
#
# Shared by THREE Play Store apps (same Render backend):
#   1) LK Studio              → com.lkstudio.app               (shop + customer)
#   2) LK Tailoring Partner   → com.lkstudio.tailoringpartner  (workers)
#   3) LK Designs             → com.lkstudio.designs           (designs only)
#
# Tailoring Partner APK opens: {CAPACITOR_SERVER_URL}/work-partner
# LK Designs APK opens:        {CAPACITOR_SERVER_URL}/designs
#
# --- LOCAL TEST (same Wi-Fi only, not for friends far away) ---
# CAPACITOR_SERVER_URL=http://192.168.1.10:3000
#
# --- PRODUCTION (Google Play) ---
CAPACITOR_SERVER_URL=https://lk-studio-1.onrender.com
