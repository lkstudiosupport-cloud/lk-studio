{
  "name": "lk-studio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/clean-next.mjs",
    "dev:stop": "node scripts/kill-port.mjs 3000",
    "dev:mobile": "node scripts/kill-port.mjs 3000 && node scripts/clean-next.mjs && next dev -H 0.0.0.0 -p 3000",
    "dev:anywhere": "node scripts/start-anywhere.mjs",
    "tunnel": "node scripts/tunnel-dev.mjs",
    "build": "prisma generate && next build",
    "start:prod": "NODE_ENV=production next start",
    "start:cluster": "node scripts/cluster.mjs",
    "lint": "next lint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:fix": "tsx scripts/fix-db.ts && prisma db push",
    "postinstall": "prisma generate",
    "cap:sync": "powershell -ExecutionPolicy Bypass -File scripts/sync-capacitor.ps1",
    "cap:open": "npx cap open android",
    "build:apk": "powershell -ExecutionPolicy Bypass -File scripts/build-apk.ps1",
    "build:apk:share": "powershell -ExecutionPolicy Bypass -File scripts/build-apk-share.ps1",
    "mobile:dev": "powershell -ExecutionPolicy Bypass -File scripts/start-mobile-dev.ps1",
    "mobile:fix": "powershell -ExecutionPolicy Bypass -File scripts/fix-mobile-network.ps1",
    "mobile:hotspot": "powershell -ExecutionPolicy Bypass -File scripts/use-pc-hotspot.ps1"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1063.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/camera": "^6.1.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/splash-screen": "^6.0.3",
    "@prisma/client": "^6.8.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "html2canvas": "^1.4.1",
    "i18next": "^25.2.1",
    "jose": "^6.0.11",
    "jspdf": "^3.0.1",
    "jspdf-autotable": "^5.0.8",
    "libphonenumber-js": "^1.12.9",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "razorpay": "^2.9.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^15.5.2",
    "tailwindcss": "^4.3.0",
    "@tailwindcss/postcss": "^4.3.0",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "localtunnel": "^2.0.2",
    "prisma": "^6.8.2",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
